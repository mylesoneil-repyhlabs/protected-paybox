#!/usr/bin/env bash
set -euo pipefail

SOURCE_INSTALL="${BASH_SOURCE[0]}"
if [[ "$SOURCE_INSTALL" != /* ]]; then
  SOURCE_INSTALL="$PWD/$SOURCE_INSTALL"
fi
if [[ -L "$SOURCE_INSTALL" ]]; then
  echo "Refusing to run a symlinked Protected PayBox installer." >&2
  exit 1
fi
REPOSITORY_ROOT="$(dirname "$SOURCE_INSTALL")"
if [[ -L "$REPOSITORY_ROOT" ]]; then
  echo "Refusing to run from a symlinked Protected PayBox source directory." >&2
  exit 1
fi
REPOSITORY_ROOT="$(cd "$REPOSITORY_ROOT" && pwd -P)"

if (( $# > 1 )) || { (( $# == 1 )) && [[ "$1" != "--upgrade" ]]; }; then
  echo "Usage: $0 [--upgrade]" >&2
  exit 1
fi
UPGRADE=false
if (( $# == 1 )); then
  UPGRADE=true
fi

compatible_node() {
  local candidate="$1"
  local candidate_major
  [[ "$candidate" == /* ]] || return 1
  [[ -x "$candidate" ]] || return 1
  candidate_major="$(
    "$candidate" -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null
  )" || return 1
  [[ "$candidate_major" =~ ^[0-9]+$ ]] && (( candidate_major >= 22 ))
}

NODE_BINARY=""
if [[ -n "${PROTECTED_PAYBOX_NODE_BINARY:-}" ]]; then
  if ! compatible_node "$PROTECTED_PAYBOX_NODE_BINARY"; then
    echo "PROTECTED_PAYBOX_NODE_BINARY must be an absolute executable Node.js 22+ path." >&2
    exit 1
  fi
  NODE_BINARY="$PROTECTED_PAYBOX_NODE_BINARY"
elif command -v node >/dev/null 2>&1 && \
  compatible_node "$(command -v node)"; then
  NODE_BINARY="$(command -v node)"
elif [[ -n "${HOME:-}" ]]; then
  for candidate in \
    "$HOME"/.cache/codex-runtimes/*/dependencies/node/bin/node; do
    if compatible_node "$candidate"; then
      NODE_BINARY="$candidate"
      break
    fi
  done
fi

if [[ -z "$NODE_BINARY" ]]; then
  for candidate in \
    "/Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node" \
    "/Applications/ChatGPT.app/Contents/Resources/node/bin/node"; do
    if compatible_node "$candidate"; then
      NODE_BINARY="$candidate"
      break
    fi
  done
fi

if [[ -z "$NODE_BINARY" ]]; then
  echo "Protected PayBox requires Node.js 22 or newer." >&2
  echo "No compatible Node.js was found on PATH, in the Codex runtime cache, or in ChatGPT for macOS." >&2
  echo "Install Node.js 22+ or set PROTECTED_PAYBOX_NODE_BINARY, then rerun this installer." >&2
  exit 1
fi

NODE_BINARY="$(
  "$NODE_BINARY" -p 'require("node:fs").realpathSync(process.execPath)'
)"
PACKAGE_VERSION="$(
  "$NODE_BINARY" -e \
    'const fs = require("node:fs"); const p = JSON.parse(fs.readFileSync(process.argv[1], "utf8")); process.stdout.write(String(p.version ?? ""));' \
    "$REPOSITORY_ROOT/package.json"
)"
if [[ ! "$PACKAGE_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Protected PayBox package version is invalid." >&2
  exit 1
fi

if [[ -n "${CODEX_HOME:-}" ]]; then
  if [[ "$CODEX_HOME" != /* ]] || [[ "$CODEX_HOME" == "/" ]]; then
    echo "CODEX_HOME must be a safe absolute directory." >&2
    exit 1
  fi
  SKILLS_ROOT="$CODEX_HOME/skills"
elif [[ -n "${HOME:-}" ]]; then
  if [[ "$HOME" != /* ]] || [[ "$HOME" == "/" ]]; then
    echo "HOME must be a safe absolute directory." >&2
    exit 1
  fi
  SKILLS_ROOT="$HOME/.agents/skills"
else
  echo "Set CODEX_HOME or HOME so the installer can locate the skills directory." >&2
  exit 1
fi

if [[ -n "${XDG_DATA_HOME:-}" ]]; then
  DATA_ROOT="$XDG_DATA_HOME"
elif [[ -n "${HOME:-}" ]]; then
  DATA_ROOT="$HOME/.local/share"
else
  echo "Set XDG_DATA_HOME or HOME so the installer can create its managed copy." >&2
  exit 1
fi
if [[ "$DATA_ROOT" != /* ]] || [[ "$DATA_ROOT" == "/" ]]; then
  echo "XDG_DATA_HOME must be a safe absolute directory." >&2
  exit 1
fi

exec "$NODE_BINARY" "$REPOSITORY_ROOT/scripts/install-managed-copy.mjs" install \
  "$REPOSITORY_ROOT" \
  "$PACKAGE_VERSION" \
  "$NODE_BINARY" \
  "$SKILLS_ROOT" \
  "$DATA_ROOT" \
  "$UPGRADE"
