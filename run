#!/usr/bin/env bash
set -euo pipefail

HARNESS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SAVED_NODE_PATH="$HARNESS_DIR/.protected-paybox-node"

compatible_node() {
  local candidate="$1"
  local candidate_major
  [[ -x "$candidate" ]] || return 1
  candidate_major="$(
    "$candidate" -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null
  )" || return 1
  [[ "$candidate_major" =~ ^[0-9]+$ ]] && (( candidate_major >= 22 ))
}

if [[ -n "${PROTECTED_PAYBOX_NODE_BINARY:-}" ]] && compatible_node "$PROTECTED_PAYBOX_NODE_BINARY"; then
  NODE_BINARY="$PROTECTED_PAYBOX_NODE_BINARY"
elif [[ -f "$SAVED_NODE_PATH" ]] && [[ ! -L "$SAVED_NODE_PATH" ]]; then
  IFS= read -r NODE_BINARY < "$SAVED_NODE_PATH"
  if ! compatible_node "$NODE_BINARY"; then
    echo "The Node.js executable saved by the installer is unavailable or older than Node 22." >&2
    echo "Rerun $HARNESS_DIR/install to refresh it." >&2
    exit 1
  fi
elif command -v node >/dev/null 2>&1 && compatible_node "$(command -v node)"; then
  NODE_BINARY="$(command -v node)"
else
  NODE_BINARY=""
  if [[ -n "${HOME:-}" ]]; then
    for candidate in "$HOME"/.cache/codex-runtimes/*/dependencies/node/bin/node; do
      if compatible_node "$candidate"; then
        NODE_BINARY="$candidate"
        break
      fi
    done
  fi
  if [[ -z "$NODE_BINARY" ]] && compatible_node "/Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node"; then
    NODE_BINARY="/Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node"
  fi
  if [[ -z "$NODE_BINARY" ]]; then
    echo "Node.js 22+ is required." >&2
    echo "You can also set PROTECTED_PAYBOX_NODE_BINARY to an absolute Node.js path." >&2
    exit 1
  fi
fi

if [[ "${1:-}" == "mcp" ]]; then
  shift
  exec "$NODE_BINARY" "$HARNESS_DIR/src/mcp-server.js" "$@"
fi

exec "$NODE_BINARY" "$HARNESS_DIR/src/cli.js" "$@"
